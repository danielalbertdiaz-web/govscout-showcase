{
  "name": "govscout-v5",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "pretest": "node scripts/check-node.mjs",
    "test": "GOVSCOUT_TEST=1 GOVSCOUT_REPO_ROOT=\"$PWD\" node --import tsx --test tests/*.test.ts",
    "fp": "node --import tsx scripts/fp.mts",
    "trackl:stats": "node --import tsx scripts/track-l/stats.mts",
    "fp:watch": "node --import tsx scripts/fp-amendment-watch.mts",
    "usage": "node --import tsx scripts/usage.mts",
    "lookup": "node --import tsx scripts/lookup.mts",
    "decide": "node --import tsx scripts/decide.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "better-sqlite3": "^12.9.0",
    "docx": "^9.6.1",
    "jose": "^6.2.3",
    "libsql": "^0.5.29",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
